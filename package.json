{
  "name": "healthflip-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:integration": "node --import tsx --test tests/api.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
